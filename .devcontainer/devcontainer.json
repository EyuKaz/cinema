{
  "name": "CinemaOS – Microservices",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspace",
  "forwardPorts": [5000, 5001, 5002, 5003, 5173, 5432, 6379],
  "portsAttributes": {
    "5000": { "label": "api-gateway" },
    "5001": { "label": "catalog" },
    "5002": { "label": "payments" },
    "5003": { "label": "recommendations" },
    "5173": { "label": "react-client" },
    "5432": { "label": "postgres" },
    "6379": { "label": "redis" }
  },
  "postCreateCommand": "echo 'All services boot via compose; open Ports tab in Codespaces.'",
  "shutdownAction": "none",
  "remoteUser": "root"
}
